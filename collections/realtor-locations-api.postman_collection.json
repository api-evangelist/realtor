          "name": "Auto-complete locations",
          "request": {
            "name": "Auto-complete locations",
            "description": {
              "content": "Returns location suggestions based on a partial input string. Use this endpoint to help users find specific addresses, cities, zip codes, neighborhoods, or schools by providing type-ahead search functionality. The returned location identifiers can be used as inputs for property search endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locations",
                "v2",
                "auto-complete"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "input",
                  "value": "<string>",
                  "description": "(Required) Partial location string for auto-completion. Can be a city name, zip code, address, or neighborhood name."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
